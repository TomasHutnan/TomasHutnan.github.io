---
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatMonthYear } from "../../utils/dates";

interface Props {
	award: CollectionEntry<"awards">;
}

const { award } = Astro.props;
const { title, event, issuer, date, cover } = award.data;
const { Content } = await render(award);
---

<li class="award-card">
	{cover && (
		<Image
			class="award-cover"
			src={cover}
			alt={title}
			widths={[480, 720, 1100]}
			sizes="(max-width: 720px) 100vw, 550px"
		/>
	)}
	<div class="award-copy">
		<strong>{title}</strong>
		<span>
			{event} - {issuer}
		</span>
		<span>{formatMonthYear(date)}</span>
		<div class="award-description">
			<Content />
		</div>
	</div>
</li>

<style>
	.award-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.award-cover {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
	}

	.award-copy {
		display: grid;
		gap: 0.35rem;
		padding: 0 0.15rem 0.2rem;
		color: var(--text-secondary);
		font-size: 0.92rem;
	}

	.award-copy strong {
		color: var(--text-main);
		line-height: 1.35;
	}

	.award-description {
		line-height: 1.6;
	}

	.award-description :global(p) {
		margin: 0.4rem 0 0;
	}
</style>
