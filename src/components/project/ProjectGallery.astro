---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { GalleryItem } from "../../utils/projects";
import Lightbox from "../Lightbox.astro";

interface Props {
	items: GalleryItem[];
	title: string;
}

const MAX_ZOOM_WIDTH = 2400;
const POSTER_WIDTH = 1280;
const STAGE_WIDTHS = [640, 960, 1280, 1920];
const STAGE_SIZES = "(max-width: 1160px) 100vw, 1128px";

const { items, title } = Astro.props;
const hasMultipleSlides = items.length > 1;

const toResizedUrl = async (src: ImageMetadata, width: number) => {
	const image = await getImage({
		src,
		width: Math.min(src.width, width),
		format: "webp",
	});
	return image.src;
};

const getThumbnail = (item: GalleryItem) =>
	item.kind === "image" ? item.image : item.poster;

const slides = await Promise.all(
	items.map(async (item, index) => ({
		item,
		id: `media-${index + 1}`,
		position: `${index + 1} of ${items.length}`,
		isFirst: index === 0,
		zoomUrl:
			item.kind === "image"
				? await toResizedUrl(item.image, MAX_ZOOM_WIDTH)
				: undefined,
		posterUrl:
			item.kind === "video"
				? await toResizedUrl(item.poster, POSTER_WIDTH)
				: undefined,
	})),
);

const hasImages = items.some((item) => item.kind === "image");
---

<section class="gallery" data-gallery aria-label={`${title} media`}>
	<div class="stage">
		<ul class="slides" data-slides tabindex="0">
			{slides.map(
				({ item, id, position, isFirst, zoomUrl, posterUrl }) => (
					<li id={id} class="slide" aria-label={position}>
						{item.kind === "image" && (
							<a
								class="slide-link"
								href={zoomUrl}
								data-zoom
								aria-label={`View full size: ${item.alt}`}
							>
								<Image
									src={item.image}
									alt={item.alt}
									widths={STAGE_WIDTHS}
									sizes={STAGE_SIZES}
									loading={isFirst ? "eager" : "lazy"}
								/>
							</a>
						)}

						{item.kind === "video" && (
							<video
								controls
								muted
								loop
								playsinline
								preload="metadata"
								poster={posterUrl}
								aria-label={item.alt}
							>
								{item.sources.map((source) => (
									<source
										src={source}
										type={`video/${source.split(".").at(-1)}`}
									/>
								))}
							</video>
						)}

						{item.kind === "youtube" && (
							<a
								class="slide-link"
								href={`https://www.youtube.com/watch?v=${item.videoId}`}
								target="_blank"
								rel="noopener noreferrer"
								data-youtube-id={item.videoId}
								aria-label={`Play ${item.alt}`}
							>
								<Image
									src={item.poster}
									alt=""
									widths={STAGE_WIDTHS}
									sizes={STAGE_SIZES}
									loading={isFirst ? "eager" : "lazy"}
								/>
								<span class="play-badge play-badge--large" />
							</a>
						)}
					</li>
				),
			)}
		</ul>

		{hasMultipleSlides && (
			<>
				<button
					class="overlay-button overlay-button--prev"
					type="button"
					data-gallery-prev
					aria-label="Previous media"
					hidden
				>
					<span aria-hidden="true">‹</span>
				</button>
				<button
					class="overlay-button overlay-button--next"
					type="button"
					data-gallery-next
					aria-label="Next media"
					hidden
				>
					<span aria-hidden="true">›</span>
				</button>
			</>
		)}
	</div>

	{hasMultipleSlides && (
		<ol class="thumbs" data-thumbs>
			{slides.map(({ item, id, position }) => (
				<li>
					<a
						class="thumb"
						href={`#${id}`}
						data-thumb
						aria-label={`Show ${position}: ${item.alt}`}
					>
						<Image
							src={getThumbnail(item)}
							alt=""
							width={Math.min(getThumbnail(item).width, 280)}
							loading="lazy"
						/>
						{item.kind !== "image" && <span class="play-badge" />}
					</a>
				</li>
			))}
		</ol>
	)}

	{hasImages && <Lightbox label={`${title} image`} />}
</section>

<script>
	import "../../scripts/project-gallery";
</script>

<style>
	.gallery {
		margin: 1.3rem 0 1rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.6rem;
	}

	.stage {
		position: relative;
		border-radius: var(--radius-sm);
		overflow: hidden;
		background: var(--bg-elevated);
	}

	.slides {
		/*
		 * Screenshots come in every shape, so the stage has a fixed shape and
		 * media is letterboxed inside it. Native scroll-snap provides swiping,
		 * and keeps the gallery usable without JavaScript.
		 */
		position: relative;
		display: flex;
		aspect-ratio: 16 / 9;
		/* Leaves room for the thumbnails above the fold. */
		max-height: min(60vh, 600px);
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.slides::-webkit-scrollbar {
		display: none;
	}

	.slides:focus-visible {
		outline-offset: -2px;
	}

	.slide {
		position: relative;
		flex: 0 0 100%;
		height: 100%;
		scroll-snap-align: center;
		scroll-snap-stop: always;
	}

	.slide-link {
		display: block;
		position: relative;
		width: 100%;
		height: 100%;
	}

	.slide-link[data-zoom] {
		cursor: zoom-in;
	}

	.slide img,
	.slide video,
	.slide :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: contain;
	}

	.play-badge {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1.6rem;
		height: 1.6rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--bg-overlay);
		transition: background-color 0.18s ease;
	}

	.play-badge::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 54%;
		transform: translate(-50%, -50%);
		border-style: solid;
		border-width: 0.3rem 0 0.3rem 0.5rem;
		border-color: transparent transparent transparent var(--text-main);
	}

	.play-badge--large {
		width: 4.5rem;
		height: 4.5rem;
	}

	.play-badge--large::after {
		border-width: 0.8rem 0 0.8rem 1.3rem;
	}

	.slide-link:hover .play-badge {
		background: var(--primary-muted);
	}

	/* Touch users swipe, so the arrows would only cover the media. */
	@media (hover: none) {
		.stage .overlay-button {
			display: none;
		}
	}

	.thumbs {
		position: relative;
		display: flex;
		gap: 0.5rem;
		margin: 0;
		padding: 0.15rem;
		list-style: none;
		overflow-x: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--border) transparent;
	}

	.thumbs li {
		flex: none;
	}

	.thumb {
		position: relative;
		display: block;
		width: 8.5rem;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		overflow: hidden;
		background: var(--bg-elevated);
		opacity: 0.6;
		outline: 2px solid transparent;
		outline-offset: -2px;
		transition:
			opacity 0.18s ease,
			outline-color 0.18s ease;
	}

	.thumb:hover,
	.thumb[aria-current="true"] {
		opacity: 1;
	}

	.thumb[aria-current="true"] {
		outline-color: var(--primary);
	}

	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	@media (max-width: 720px) {
		.thumb {
			width: 6.5rem;
		}

		.play-badge--large {
			width: 3.2rem;
			height: 3.2rem;
		}

		.play-badge--large::after {
			border-width: 0.55rem 0 0.55rem 0.9rem;
		}
	}
</style>
