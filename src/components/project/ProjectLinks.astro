---
import type { CollectionEntry } from "astro:content";
import DemoIcon from "../../assets/icons/demo.svg";
import PaperIcon from "../../assets/icons/paper.svg";
import RepositoryIcon from "../../assets/icons/repository.svg";

interface Props {
	project: CollectionEntry<"projects">;
	iconOnly?: boolean;
}

const { project, iconOnly = false } = Astro.props;
const { title, demo, paper, repo } = project.data;

const links = [
	{ href: demo, label: "Demo", Icon: DemoIcon },
	{ href: paper, label: "Paper", Icon: PaperIcon },
	{ href: repo, label: "Repository", Icon: RepositoryIcon },
].filter((link) => link.href);
---

{links.length > 0 && (
	<div class:list={["project-links", { "icon-only": iconOnly }]}>
		{links.map(({ href, label, Icon }) => (
			<a
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${title}: ${label}`}
			>
				<Icon class="link-icon" aria-hidden="true" />
				{!iconOnly && <span>{label}</span>}
			</a>
		))}
	</div>
)}

<style>
	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		align-items: center;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9rem;
		line-height: 1;
		transition:
			color 0.2s ease,
			opacity 0.2s ease;
	}

	.project-links a:hover {
		color: var(--primary-soft);
	}

	.icon-only {
		flex-wrap: nowrap;
		gap: 0.5rem;
		color: var(--primary-soft);
	}

	.icon-only a {
		opacity: 0.7;
	}

	.icon-only a:hover {
		opacity: 1;
	}

	.link-icon {
		width: 18px;
		height: 18px;
		flex: none;
	}
</style>
