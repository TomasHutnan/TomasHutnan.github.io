---
interface Props {
	id?: string;
	title: string;
	description?: string;
	headingLevel?: "h1" | "h2";
}

const { id, title, description, headingLevel: Heading = "h2" } = Astro.props;
---

<section id={id} class="section">
	<div class="section-heading">
		<Heading class="section-title">{title}</Heading>
		{description && <p class="section-description">{description}</p>}
	</div>
	<div class="section-body">
		<slot />
	</div>
</section>

<style>
	.section {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.2rem;
	}

	.section-heading {
		display: grid;
		gap: 0.5rem;
	}

	.section-title {
		margin: 0;
		font-size: clamp(1.5rem, 2vw, 2.1rem);
	}

	.section-description {
		margin: 0;
		max-width: 70ch;
		color: var(--text-secondary);
		line-height: 1.7;
	}
</style>
