---
import { TAG_LABELS, type TagSlug } from "../data/tags";
import { getTagHref } from "../utils/tags";

interface Props {
	tag: TagSlug;
	compact?: boolean;
}

const { tag, compact = false } = Astro.props;
---

<a
	class:list={["tag-link", { compact }]}
	href={getTagHref(tag)}
	data-tag-slug={tag}
>
	{TAG_LABELS[tag]}
</a>

<style>
	.tag-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		background: var(--primary-tint);
		color: var(--primary-soft);
		text-decoration: none;
		font-weight: 600;
		line-height: 1.1;
		white-space: nowrap;
		transition:
			transform 160ms ease,
			background 160ms ease,
			color 160ms ease;
	}

	.compact {
		font-size: 0.7rem;
	}

	.tag-link:hover {
		transform: translateY(-1px);
		background: var(--primary-tint-strong);
		color: var(--text-main);
	}

	.tag-link.active {
		background: linear-gradient(
			90deg,
			var(--primary-tint-strong),
			var(--accent-tint)
		);
		color: var(--text-main);
	}
</style>
