---
import { getEntries, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getProjectHref, getCoverTransitionName } from "../utils/projects";
import ProjectLinks from "./project/ProjectLinks.astro";
import TagList from "./TagList.astro";
import AwardIcon from "../assets/icons/award.svg";

interface Props {
	project: CollectionEntry<"projects">;
}

const MAX_VISIBLE_TAGS = 3;

const { project } = Astro.props;
const { title, cover, role, type, description, tags } = project.data;

const coverTransition = getCoverTransitionName(project);
const awards = project.data.awards ? await getEntries(project.data.awards) : [];
const [topAward, ...otherAwards] = awards;
const otherAwardTitles = otherAwards
	.map((award) => award.data.shortTitle)
	.join(", ");
---

<article class="project-card" data-tag-slugs={tags.join(" ")}>
	<Image
		class="project-cover"
		src={cover}
		alt=""
		widths={[320, 480, 640, 800]}
		sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 280px"
		data-cover-transition={coverTransition}
	/>

	<div class="project-copy">
		<div class="project-card-header">
			<h3>
				<a href={getProjectHref(project)}>{title}</a>
			</h3>
			<ProjectLinks project={project} iconOnly />
		</div>

		<p class="project-role">
			{role} • <span class="project-type">{type}</span>
		</p>

		{topAward && (
			<p class="project-award">
				<AwardIcon class="award-icon" aria-hidden="true" />
				<span>{topAward.data.shortTitle}</span>
				{otherAwards.length > 0 && (
					<span class="award-more" title={otherAwardTitles}>
						<span aria-hidden="true">+{otherAwards.length}</span>
						<span class="sr-only">and {otherAwardTitles}</span>
					</span>
				)}
			</p>
		)}

		<p>{description}</p>

		<div class="project-tags">
			<TagList tags={tags.slice(0, MAX_VISIBLE_TAGS)} compact />
		</div>
	</div>
</article>

<style>
	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--card-gradient);
		box-shadow: var(--shadow-card);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--primary-line);
		transform: translateY(-2px);
	}

	.project-card[hidden] {
		display: none;
	}

	.project-cover {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.project-copy {
		flex: 1;
		margin-top: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.project-card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.5rem;
	}

	h3 {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15rem;
	}

	h3 a {
		text-decoration: none;
	}

	/* Stretches the title link over the card, so the whole card is one link. */
	h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: var(--radius-lg);
	}

	h3 a:focus-visible {
		outline: none;
	}

	h3 a:focus-visible::after {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* Keeps these clickable above the stretched title link. */
	.project-card-header :global(.project-links),
	.project-tags,
	.award-more {
		position: relative;
		z-index: 1;
	}

	p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-main);
	}

	p.project-role {
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	.project-type {
		text-transform: capitalize;
	}

	p.project-award {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	.award-icon {
		width: 16px;
		height: 16px;
		flex: none;
		color: var(--award);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.award-more {
		color: var(--text-secondary);
		cursor: help;
	}

	.project-tags {
		margin-top: auto;
		padding-top: 0.2rem;
	}
</style>
