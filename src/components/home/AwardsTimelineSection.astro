---
import Section from "../Section.astro";
import type { CollectionEntry } from "astro:content";
import type { AwardYearGroup } from "../../utils/awards";
import { getProjectHref } from "../../utils/projects";

interface Props {
	groups: AwardYearGroup[];
	awardProjectMap: Map<string, CollectionEntry<"projects">>;
}

const { groups, awardProjectMap } = Astro.props;
---

<Section
	id="awards"
	eyebrow="Awards"
	title="Recognition over time"
	description="A concise timeline of competition results and sponsor awards across recent years."
>
	<div class="timeline">
		{groups.map(({ year, awards }) => (
			<section class="timeline-group">
				<h3>{year}</h3>
				<ul>
					{awards.map((award) => {
						const project = awardProjectMap.get(award.id);
						return (
							<li>
								<strong>{award.data.title}</strong>
								<span>
									{award.data.event} - {award.data.issuer}
								</span>
								{project && (
									<a
										class="award-project-link"
										href={getProjectHref(project)}
									>
										{project.data.title}
									</a>
								)}
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</div>
</Section>

<style>
	.timeline {
		display: grid;
		gap: 1rem;
	}

	.timeline-group {
		padding: 1rem 1.1rem;
	}

	.timeline-group h3 {
		margin: 0 0 0.9rem;
		font-size: 1.1rem;
	}

	.timeline-group ul {
		list-style: none;
		display: grid;
		gap: 0.8rem;
		padding: 0;
		margin: 0;
	}

	.timeline-group li {
		display: grid;
		gap: 0.2rem;
		padding-left: 1rem;
		border-left: 2px solid var(--primary-line);
	}

	.timeline-group strong {
		font-size: 0.98rem;
	}

	.timeline-group span {
		color: var(--text-secondary);
		line-height: 1.6;
	}

	.award-project-link {
		align-self: start;
		width: fit-content;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--primary-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.award-project-link:hover {
		color: var(--primary);
	}

	@media (min-width: 900px) {
		.timeline {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
