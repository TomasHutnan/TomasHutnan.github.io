---
import Section from "../Section.astro";
import type { CollectionEntry } from "astro:content";
import { getShortEventName, type AwardYearGroup } from "../../utils/awards";
import { getProjectHref } from "../../utils/projects";

interface Props {
	groups: AwardYearGroup[];
	awardProjectMap: Map<string, CollectionEntry<"projects">>;
}

const { groups, awardProjectMap } = Astro.props;
---

<Section id="awards" title="Awards">
	<div class="award-years">
		{groups.map(({ year, awards }) => (
			<section class="year-group">
				<h3>{year}</h3>
				<ul>
					{awards.map((award) => {
						const project = awardProjectMap.get(award.id);
						return (
							<li>
								<strong>{award.data.title}</strong>
								<span>
									{getShortEventName(award.data.event)}
								</span>
								{project && (
									<a href={getProjectHref(project)}>
										{project.data.title}
									</a>
								)}
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</div>
</Section>

<style>
	.award-years {
		display: grid;
		gap: 1rem;
	}

	.year-group {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
	}

	h3 {
		margin: 0;
		font-size: 1.05rem;
		color: var(--text-secondary);
	}

	ul {
		list-style: none;
		display: grid;
		gap: 0.7rem;
		padding: 0;
		margin: 0;
	}

	li {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(
				0,
				0.8fr
			);
		gap: 1rem;
		align-items: baseline;
	}

	strong {
		font-size: 0.98rem;
	}

	span {
		color: var(--text-secondary);
	}

	a {
		color: var(--primary-soft);
		text-decoration: none;
		font-size: 0.92rem;
	}

	a:hover {
		color: var(--primary);
	}

	@media (max-width: 720px) {
		.year-group {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.6rem;
		}

		li {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}
	}
</style>
