---
import { getEntries, type CollectionEntry } from "astro:content";
import { slugify } from "../../utils/slug";
import TagLink from "../TagLink.astro";
import demoIcon from "../../assets/icons/demo.svg";
import repoIcon from "../../assets/icons/repository.svg";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const projectHref = `/projects/${slugify(project.id)}`;
const awards = project.data.awards ? await getEntries(project.data.awards) : [];
---

<article
	class="project-card"
	data-tags={project.data.tags.join(" ")}
	data-tag-slugs={project.data.tags.map((t) => slugify(t)).join(" ")}
>
	<a
		class="project-cover-link"
		href={projectHref}
		aria-label={`Open ${project.data.title}`}
	>
		<img
			src={project.data.cover.src}
			alt={project.data.title}
			width={project.data.cover.width}
			height={project.data.cover.height}
			loading="lazy"
		/>
	</a>

	<div class="project-copy">
		<div class="project-card-header">
			<h3>
				<a href={projectHref}>{project.data.title}</a>
			</h3>
			{(project.data.demo || project.data.repo) && (
				<div class="project-card-links">
					{project.data.demo && (
						<a
							href={project.data.demo}
							target="_blank"
							rel="noopener noreferrer"
							class="card-link"
							aria-label="Demo"
						>
							<img
								src={demoIcon.src}
								alt="Demo"
								class="card-link-icon"
							/>
						</a>
					)}
					{project.data.repo && (
						<a
							href={project.data.repo}
							target="_blank"
							rel="noopener noreferrer"
							class="card-link"
							aria-label="Repository"
						>
							<img
								src={repoIcon.src}
								alt="Repository"
								class="card-link-icon"
							/>
						</a>
					)}
				</div>
			)}
		</div>

		<p class="project-role">
			{project.data.role} • {project.data.type}
		</p>

		<p>{project.data.description}</p>

		{awards.length > 0 && (
			<div class="project-awards">
				{awards.map((award) => (
					<span class="award-badge" title={award.data.title}>
						🏆 {award.data.title}
					</span>
				))}
			</div>
		)}
		<ul class="tag-list">
			{project.data.tags.slice(0, 4).map((tag) => (
				<li>
					<TagLink tag={tag} size={0.7} />
				</li>
			))}
		</ul>
	</div>
</article>

<style>
	.project-card {
		display: block;
		gap: 1rem;
		height: 100%;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: linear-gradient(
			180deg,
			rgba(17, 24, 39, 0.94),
			rgba(15, 23, 42, 0.92)
		);
		box-shadow: var(--shadow-card);
	}

	.project-cover-link {
		display: block;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.project-cover-link img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	.project-copy {
		margin-top: 1rem;
		display: grid;
		gap: 0.8rem;
	}

	.project-role {
		color: var(--text-secondary);
		font-size: 0.85rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.project-card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.project-card-links {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		opacity: 0.7;
		transition: opacity 0.2s;
	}

	.card-link:hover {
		opacity: 1;
	}

	.card-link-icon {
		width: 18px;
		height: 18px;
		filter: invert(1) sepia(1) saturate(1000%) hue-rotate(180deg)
			brightness(1.2);
	}

	h3 {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15rem;
	}

	h3 a {
		text-decoration: none;
	}

	p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-main);
	}

	.tag-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0;
	}

	.tag-list li {
		display: flex;
	}

	.project-awards {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: -0.2rem;
	}
	.award-badge {
		font-size: 0.8rem;
		background: rgba(255, 215, 0, 0.15);
		color: #ffd700;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
	}
</style>
