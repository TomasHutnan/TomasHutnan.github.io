---
import type { CollectionEntry } from "astro:content";
import Section from "../Section.astro";
import TagCloud from "../TagCloud.astro";
import { collectTagStats } from "../../utils/tags";

interface Props {
	projects: CollectionEntry<"projects">[];
	languages: string[];
}

const { projects, languages } = Astro.props;
---

<Section
	id="skills"
	title="Tools and domains I work in"
	description="Sized by how many of my projects use each one. Select a tag to see them."
>
	<TagCloud tags={collectTagStats(projects)} standalone />

	<p class="languages">
		<span>Languages</span>
		{languages.join(" · ")}
	</p>
</Section>

<style>
	.languages {
		margin: 0.5rem 0 0;
		color: var(--text-secondary);
		text-align: center;
	}

	.languages span {
		margin-right: 0.6rem;
		color: var(--text-main);
		font-weight: 600;
	}
</style>
