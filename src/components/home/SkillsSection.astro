---
import type { CollectionEntry } from "astro:content";
import Section from "../Section.astro";
import TagCloud from "../TagCloud.astro";
import type { SkillLine } from "../../data/home";
import { collectTagStats } from "../../utils/tags";

interface Props {
	projects: CollectionEntry<"projects">[];
	lines: SkillLine[];
}

const { projects, lines } = Astro.props;
---

<Section
	id="skills"
	title="Tools and domains I work in"
	description="Sized by how many of my projects use each one. Select a tag to see them."
>
	<TagCloud tags={collectTagStats(projects)} standalone />

	<dl class="skill-lines">
		{lines.map(({ label, items }) => (
			<div>
				<dt>{label}</dt>
				<dd>{items.join(" · ")}</dd>
			</div>
		))}
	</dl>
</Section>

<style>
	.skill-lines {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem 2rem;
		margin: 0.5rem 0 0;
		color: var(--text-secondary);
	}

	.skill-lines div {
		display: flex;
		gap: 0.6rem;
	}

	.skill-lines dt {
		color: var(--text-main);
		font-weight: 600;
	}

	.skill-lines dd {
		margin: 0;
	}

	@media (max-width: 480px) {
		.skill-lines {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.skill-lines div {
			flex-direction: column;
			gap: 0;
		}
	}
</style>
