---
import Section from "../Section.astro";
import type { ContactLink } from "../../data/home";
import { getExternalLinkProps } from "../../utils/links";

interface Props {
	links: ContactLink[];
}

const { links } = Astro.props;
---

<Section id="contact" title="Let's build something interesting">
	<div class="contact-panel">
		<p class="contact-copy">
			I'm open to projects, collaborations, and conversations around
			machine learning, computer vision, and product-focused software.
		</p>

		<div class="contact-links">
			{links.map((link) => (
				<a href={link.href} {...getExternalLinkProps(link.href)}>
					<strong>{link.label}</strong>
					<span>{link.value}</span>
				</a>
			))}
		</div>
	</div>
</Section>

<style>
	.contact-panel {
		display: grid;
		gap: 1rem;
		padding: 1.2rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: linear-gradient(
			135deg,
			var(--primary-tint) 0%,
			var(--accent-tint-faint) 35%,
			var(--bg-surface) 75%
		);
		box-shadow: var(--shadow-card);
		position: relative;
		overflow: hidden;
	}

	.contact-panel::before {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at top left,
			var(--primary-tint),
			transparent 60%
		);
		pointer-events: none;
	}

	.contact-copy {
		margin: 0;
		max-width: 70ch;
		line-height: 1.75;
		color: var(--text-secondary);
	}

	.contact-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.85rem;
	}

	.contact-links a {
		display: grid;
		gap: 0.25rem;
		padding: 0.95rem 1rem;
		text-decoration: none;
	}

	.contact-links strong {
		font-size: 0.95rem;
	}

	.contact-links span {
		color: var(--text-secondary);
		line-height: 1.55;
	}
</style>
