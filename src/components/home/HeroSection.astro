---
import type { ContactIcon, ContactLink, QuickInfoItem } from "../../data/home";
import { getExternalLinkProps } from "../../utils/links";
import EmailIcon from "../../assets/icons/email.svg";
import GitHubIcon from "../../assets/icons/github.svg";
import LinkedInIcon from "../../assets/icons/linkedin.svg";

interface Props {
	name: string;
	title: string;
	summary: string;
	primaryHref: string;
	primaryLabel: string;
	secondaryHref: string;
	secondaryLabel: string;
	links: ContactLink[];
	facts: QuickInfoItem[];
	highlights: string[];
}

const ICONS: Record<ContactIcon, typeof EmailIcon> = {
	email: EmailIcon,
	github: GitHubIcon,
	linkedin: LinkedInIcon,
};

const {
	name,
	title,
	summary,
	primaryHref,
	primaryLabel,
	secondaryHref,
	secondaryLabel,
	links,
	facts,
	highlights,
} = Astro.props;
---

<section class="hero">
	<div class="hero-copy">
		<h1>{name}</h1>
		<p class="hero-title">{title}</p>
		<p class="hero-summary">{summary}</p>

		<div class="hero-actions">
			<a class="btn btn-primary" href={primaryHref}>
				{primaryLabel}
			</a>
			<a
				class="btn btn-outline"
				href={secondaryHref}
				download="Tomas_Hutnan_Resume.pdf"
			>
				{secondaryLabel}
			</a>
		</div>

		<div class="hero-social">
			{links.map(({ href, label, icon }) => {
				const Icon = ICONS[icon];
				return (
					<a
						href={href}
						aria-label={label}
						{...getExternalLinkProps(href)}
					>
						<Icon width="18" height="18" aria-hidden="true" />
					</a>
				);
			})}
		</div>
	</div>

	<dl class="hero-facts">
		{facts.map(({ label, value }) => (
			<div>
				<dt>{label}</dt>
				<dd>{value}</dd>
			</div>
		))}
		<div>
			<dt>Highlights</dt>
			<dd>
				<ul>
					{highlights.map((highlight) => (
						<li>{highlight}</li>
					))}
				</ul>
			</dd>
		</div>
	</dl>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
		padding: 2.2rem 0 0.5rem;
	}

	.hero-copy {
		display: grid;
		gap: 1rem;
	}

	.hero-facts {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--card-gradient);
		box-shadow: var(--shadow-card);
	}

	dt {
		margin-bottom: 0.25rem;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	dd {
		margin: 0;
		font-weight: 600;
		line-height: 1.45;
	}

	dd ul {
		display: grid;
		gap: 0.3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}
	}

	h1 {
		margin: 0;
		font-size: clamp(2.4rem, 6vw, 5rem);
		line-height: 0.95;
	}

	.hero-title {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		font-weight: 600;
	}

	.hero-summary {
		margin: 0;
		max-width: 60ch;
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--text-secondary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		padding-top: 0.4rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.2rem;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn-primary {
		background: var(--primary);
		color: var(--bg-main);
	}

	.btn-outline {
		border: 1px solid var(--border);
		background: var(--bg-translucent);
		color: var(--text-main);
	}

	.hero-social {
		display: flex;
		gap: 0.5rem;
	}

	.hero-social a {
		display: flex;
		padding: 0.4rem;
		border-radius: var(--radius-sm);
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color 0.18s ease,
			background-color 0.18s ease;
	}

	.hero-social a:hover {
		color: var(--primary);
		background: var(--primary-tint-faint);
	}
</style>
