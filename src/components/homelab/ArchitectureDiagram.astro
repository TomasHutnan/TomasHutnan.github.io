---
import type { Service } from "../../data/homelab";

interface Props {
	services: Service[];
}

const { services } = Astro.props;
const groups = [
	{ id: "apps", label: "Apps" },
	{ id: "admin", label: "Admin · private" },
] as const;
---

<figure class="diagram">
	<div class="flow">
		<div class="node node--edge">
			<span class="node-title">Browser</span>
			<span class="node-detail">*.hutnan.dev</span>
		</div>

		<span class="arrow" aria-hidden="true">
			<span>HTTPS</span>
		</span>

		<div class="node node--proxy">
			<span class="node-title">Caddy</span>
			<span class="node-detail">
				TLS and routing from container labels
			</span>
		</div>

		<span class="arrow" aria-hidden="true">
			<span>web network</span>
		</span>

		<div class="network">
			<span class="network-label">Docker · one VPS</span>
			{groups.map(({ id, label }) => (
				<div class:list={["group", `group--${id}`]}>
					<span class="group-label">{label}</span>
					<ul>
						{services
							.filter((service) => service.group === id)
							.map((service) => (
								<li>
									<a
										class="service"
										href={`#service-${service.id}`}
									>
										{service.name}
										<span>{service.role}</span>
									</a>
								</li>
							))}
					</ul>
				</div>
			))}
		</div>
	</div>
	<figcaption>
		Requests reach a single Caddy proxy, which forwards each subdomain to
		its container. Select a service for details.
	</figcaption>
</figure>

<style>
	.diagram {
		margin: 0;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(
				circle at 0 0,
				var(--primary-tint-faint),
				transparent 50%
			),
			var(--bg-surface);
	}

	.flow {
		display: grid;
		grid-template-columns: 9rem auto 11rem auto minmax(0, 1fr);
		align-items: center;
	}

	.node {
		display: grid;
		gap: 0.25rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--bg-elevated);
	}

	.node--proxy {
		border-color: var(--primary-line);
		box-shadow: 0 0 0 4px var(--primary-tint-faint);
	}

	.node-title {
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.node-detail {
		color: var(--text-secondary);
		font-size: 0.8rem;
		line-height: 1.35;
	}

	.arrow {
		position: relative;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 2.2rem;
	}

	/* A line with a head, drawn in CSS so it can turn downwards on phones. */
	.arrow::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 0.4rem;
		right: 0.7rem;
		border-top: 1px dashed var(--primary-line);
	}

	.arrow::after {
		content: "";
		position: absolute;
		top: calc(50% - 4px);
		right: 0.45rem;
		border: 4px solid transparent;
		border-left: 6px solid var(--primary);
		border-right: 0;
	}

	.arrow span {
		position: absolute;
		bottom: calc(50% + 0.3rem);
		color: var(--text-secondary);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.network {
		display: grid;
		gap: 0.9rem;
		padding: 1.4rem 1rem 1rem;
		position: relative;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
	}

	.network-label {
		position: absolute;
		top: -0.65rem;
		left: 0.8rem;
		padding: 0 0.4rem;
		background: var(--bg-surface);
		color: var(--text-secondary);
		font-size: 0.75rem;
	}

	.group-label {
		display: block;
		margin-bottom: 0.45rem;
		color: var(--text-secondary);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.group ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.service {
		display: grid;
		gap: 0.1rem;
		height: 100%;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
		color: var(--text-main);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.service span {
		color: var(--text-secondary);
		font-size: 0.75rem;
		font-weight: 400;
	}

	.service:hover {
		border-color: var(--primary-line);
		transform: translateY(-1px);
	}

	.group--admin .service {
		border-style: dashed;
		background: transparent;
	}

	figcaption {
		margin-top: 1.1rem;
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	@media (max-width: 860px) {
		.flow {
			grid-template-columns: minmax(0, 1fr);
			justify-items: stretch;
		}

		.arrow {
			width: auto;
			height: 2.8rem;
		}

		.arrow::before {
			top: 0.3rem;
			bottom: 0.6rem;
			left: 50%;
			right: auto;
			border-top: 0;
			border-left: 1px dashed var(--primary-line);
		}

		.arrow::after {
			top: auto;
			bottom: 0.3rem;
			right: auto;
			left: calc(50% - 4px);
			border: 4px solid transparent;
			border-top: 6px solid var(--primary);
			border-bottom: 0;
		}

		.arrow span {
			bottom: auto;
			left: calc(50% + 0.6rem);
		}
	}
</style>
