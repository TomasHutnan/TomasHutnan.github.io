---
import SearchDialog from "./SearchDialog.astro";

const links = [
	{ href: "/projects/", label: "Projects" },
	{ href: "/#contact", label: "Contact" },
];
---

<nav class="nav">
	<div class="nav-container">
		<a href="/" class="nav-logo">
			Tomáš Hutňan
		</a>

		<div class="nav-links">
			{links.map((link) => (
				<a href={link.href} class="nav-link">
					{link.label}
				</a>
			))}
			<button class="search-button" type="button" data-search-open>
				<svg viewBox="0 0 20 20" aria-hidden="true">
					<circle cx="8.5" cy="8.5" r="5.5"></circle>
					<path d="m13 13 4 4"></path>
				</svg>
				<span class="search-label">Search</span>
				<kbd data-search-shortcut>Ctrl K</kbd>
			</button>
		</div>
	</div>
</nav>

<!-- Lives with the button that opens it, so every page with a navbar has it. -->
<SearchDialog />

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg-main);
		border-bottom: 1px solid var(--border);
	}

	.nav-container {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0.85rem var(--page-gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-logo {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--text-main);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav-logo:hover {
		color: var(--primary);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.6rem;
	}

	.nav-link {
		position: relative;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav-link:hover {
		color: var(--primary);
	}

	.nav-link::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -4px;
		width: 0%;
		height: 1px;
		background: var(--primary);
		transition: width 0.25s ease;
	}

	.nav-link:hover::after {
		width: 100%;
	}

	.search-button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.5rem 0.35rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.88rem;
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.search-button:hover {
		border-color: var(--primary-line);
		color: var(--text-main);
	}

	.search-button svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.search-button kbd {
		padding: 0.05rem 0.3rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: inherit;
		font-size: 0.7rem;
	}

	@media (max-width: 600px) {
		.search-label,
		.search-button kbd {
			display: none;
		}
	}
</style>
