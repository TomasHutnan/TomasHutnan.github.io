---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { sortProjectsByRecency } from "../../utils/projects";
import {
	collectTagStats,
	getTagAriaLabel,
	getTagCloudFontSize,
	getTagHref,
	isStrongTag,
} from "../../utils/tags";

const projects = sortProjectsByRecency(await getCollection("projects"));

const tagStats = collectTagStats(projects);
const maxTagCount = tagStats[0]?.count ?? 1;
---

<Layout
	pageTitle="Projects"
	description="All projects from Tomáš Hutňan's portfolio, covering machine learning, games, and full-stack systems."
>
	<main class="page-container">
		<Section
			eyebrow="Projects"
			title="Explore by Technology"
			description="Explore projects by technologies and domains I work with most frequently."
			headingLevel="h1"
		>
			<div class="tag-cloud" data-tag-cloud>
				{tagStats.map(({ slug, label, count }) => (
					<a
						class:list={[
							"tag-box",
							{ "tag-box--strong": isStrongTag(count) },
						]}
						href={getTagHref(slug)}
						data-tag-slug={slug}
						aria-label={getTagAriaLabel(label, count)}
						style={`font-size: ${getTagCloudFontSize(count, maxTagCount)}px;`}
					>
						{label}
					</a>
				))}
			</div>

			<h2 class="index-title">Project Index</h2>
			<div class="filter-bar">
				<p
					class="filter-summary"
					data-filter-summary
					aria-live="polite"
				>
					Showing {projects.length} projects
				</p>
				<button class="filter-clear" data-filter-clear hidden>
					Clear filter
				</button>
			</div>

			<div class="card-grid">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</Section>
	</main>
</Layout>

<script>
	import "../../scripts/project-filter";
</script>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.4rem;
		align-items: center;
		padding: 0.1rem 0 0.35rem;
	}

	.tag-box {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.05rem 0.2rem;
		border-radius: 0.2rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color 160ms ease,
			transform 160ms ease;
		line-height: 1.1;
		white-space: nowrap;
	}

	.tag-box[hidden] {
		display: none;
	}

	.tag-box:hover {
		transform: translateY(-1px);
		color: var(--text-main);
	}

	.tag-box--strong {
		color: var(--text-main);
		font-weight: 700;
	}

	.tag-box.active {
		color: var(--text-main);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.16em;
	}

	.index-title {
		margin: 2rem 0 0;
		font-size: 2rem;
	}

	.filter-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.2rem;
		margin: 0.75rem 0 1rem;
	}

	.filter-summary {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.filter-clear {
		padding: 0.3rem 0;
		border: 0;
		background: transparent;
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.filter-clear[hidden] {
		display: none;
	}

	.filter-clear:hover {
		color: var(--text-main);
	}
</style>
