---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { sortProjectsByRecency } from "../../utils/projects";
import {
	collectTagStats,
	getTagAriaLabel,
	getTagCloudFontSize,
	getTagHref,
	isStrongTag,
} from "../../utils/tags";

const projects = sortProjectsByRecency(await getCollection("projects"));

const tagStats = collectTagStats(projects);
const maxTagCount = tagStats[0]?.count ?? 1;
---

<Layout
	pageTitle="Projects"
	description="All projects from Tomáš Hutňan's portfolio, covering machine learning, games, and full-stack systems."
>
	<main class="page-container">
		<Section
			title="Projects"
			description="Select tags to narrow the list."
			headingLevel="h1"
		>
			<div class="tag-cloud" data-tag-cloud>
				{tagStats.map(({ slug, label, count }) => (
					<a
						class:list={[
							"tag-box",
							{ "tag-box--strong": isStrongTag(count) },
						]}
						href={getTagHref(slug)}
						data-tag-slug={slug}
						aria-label={getTagAriaLabel(label, count)}
						style={`font-size: ${getTagCloudFontSize(count, maxTagCount)}px;`}
					>
						{label}
					</a>
				))}
			</div>

			<h2 class="index-title">All projects</h2>
			<div class="filter-bar">
				<p
					class="filter-summary"
					data-filter-summary
					aria-live="polite"
				>
					Showing {projects.length} projects
				</p>
				<button class="filter-clear" data-filter-clear hidden>
					Clear filter
				</button>
			</div>

			<div class="card-grid">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</Section>
	</main>
</Layout>

<script>
	import "../../scripts/project-filter";
</script>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.4rem;
		align-items: center;
		padding: 0.1rem 0 0.35rem;
	}

	.tag-box {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.05rem 0.2rem;
		border-radius: 0.2rem;
		color: var(--text-secondary);
		text-decoration: none;
		transition:
			color 160ms ease,
			transform 160ms ease;
		line-height: 1.1;
		white-space: nowrap;
	}

	.tag-box[hidden] {
		display: none;
	}

	.tag-box:hover {
		transform: translateY(-1px);
		color: var(--text-main);
	}

	.tag-box--strong {
		color: var(--text-main);
		font-weight: 700;
	}

	.tag-box.active {
		color: var(--text-main);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.16em;
	}

	/* Cloud mode, switched on by scripts/tag-cloud.ts once words are placed. */

	.tag-cloud {
		--cloud-top: rgba(203, 213, 225, 0.1);
		--cloud-bottom: rgba(56, 189, 248, 0.06);
		--cloud-light: rgba(226, 232, 240, 0.07);
		--cloud-rim: rgba(103, 232, 249, 0.5);
		--cloud-glow: rgba(34, 211, 238, 0.08);
	}

	.tag-cloud.is-cloud {
		position: relative;
		display: block;
		padding: 0;
		margin: 0.5rem 0 0;
	}

	.tag-cloud.is-settled {
		transition: height 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tag-cloud :global(.tag-cloud-shape) {
		display: none;
	}

	.tag-cloud.is-cloud :global(.tag-cloud-shape) {
		display: block;
		position: absolute;
		top: 0;
		left: 0;
		overflow: visible;
		pointer-events: none;
		/* Its own layer, so the drift moves pixels instead of re-running the
		   blur filters every frame. */
		will-change: translate;
		animation: cloud-drift 11s ease-in-out infinite;
	}

	.tag-cloud.is-settled :global(.tag-cloud-shape) {
		transition:
			width 520ms cubic-bezier(0.22, 1, 0.36, 1),
			height 520ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tag-cloud :global(.cloud-body) {
		fill: url(#cloud-fill);
		filter: url(#cloud-goo);
	}

	.tag-cloud :global(.cloud-rim) {
		fill: var(--cloud-rim);
		filter: url(#cloud-rim);
		opacity: 0.5;
	}

	.tag-cloud :global(.cloud-light) {
		fill: url(#cloud-puff);
	}

	.tag-cloud :global(.cloud-glow) {
		fill: var(--cloud-glow);
		filter: url(#cloud-glow);
	}

	@keyframes cloud-drift {
		50% {
			translate: 0 -4px;
		}
	}

	.tag-cloud.is-cloud .tag-box {
		position: absolute;
		top: 0;
		left: 0;
		padding: 2px 6px;
		line-height: 1.15;
	}

	.tag-cloud.is-cloud .tag-box[hidden] {
		display: inline-flex;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.tag-cloud.is-settled .tag-box {
		transition:
			transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
			font-size 520ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 260ms ease,
			visibility 260ms,
			color 160ms ease;
	}

	.tag-cloud.is-cloud .tag-box:hover {
		color: var(--primary-soft);
		text-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
	}

	.index-title {
		margin: 2rem 0 0;
		font-size: 2rem;
	}

	.filter-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.2rem;
		margin: 0.75rem 0 1rem;
	}

	.filter-summary {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.filter-clear {
		padding: 0.3rem 0;
		border: 0;
		background: transparent;
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.filter-clear[hidden] {
		display: none;
	}

	.filter-clear:hover {
		color: var(--text-main);
	}
</style>
