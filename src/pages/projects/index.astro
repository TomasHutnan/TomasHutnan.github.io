---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { sortProjectsByRecency } from "../../utils/projects";
import TagCloud from "../../components/TagCloud.astro";
import { collectTagStats } from "../../utils/tags";

const projects = sortProjectsByRecency(await getCollection("projects"));
---

<Layout
	pageTitle="Projects"
	shareCard="projects"
	description="All projects from Tomáš Hutňan's portfolio, covering machine learning, games, and full-stack systems."
>
	<main class="page-container">
		<Section
			title="Projects"
			description="Select tags to narrow the list."
			headingLevel="h1"
		>
			<TagCloud tags={collectTagStats(projects)} />

			<h2 class="index-title">All projects</h2>
			<div class="filter-bar">
				<p
					class="filter-summary"
					data-filter-summary
					aria-live="polite"
				>
					Showing {projects.length} projects
				</p>
				<button class="filter-clear" data-filter-clear hidden>
					Clear filter
				</button>
			</div>

			<div class="card-grid">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</Section>
	</main>
</Layout>

<script>
	import "../../scripts/project-filter";
</script>

<style>
	.index-title {
		margin: 2rem 0 0;
		font-size: 2rem;
	}

	.filter-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.2rem;
		margin: 0.75rem 0 1rem;
	}

	.filter-summary {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.filter-clear {
		padding: 0.3rem 0;
		border: 0;
		background: transparent;
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
	}

	.filter-clear[hidden] {
		display: none;
	}

	.filter-clear:hover {
		color: var(--text-main);
	}
</style>
