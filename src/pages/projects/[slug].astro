---
import {
	getCollection,
	getEntries,
	render,
	type CollectionEntry,
} from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import TagList from "../../components/TagList.astro";
import Lightbox from "../../components/Lightbox.astro";
import AwardCard from "../../components/project/AwardCard.astro";
import ProjectGallery from "../../components/project/ProjectGallery.astro";
import ProjectLinks from "../../components/project/ProjectLinks.astro";
import { formatDateRange } from "../../utils/dates";
import { getGalleryItems } from "../../utils/projects";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const {
	title,
	description,
	type,
	role,
	shortRoleDescription,
	cover,
	tags,
	collaborators = [],
	contribution,
	startedAt,
	completedAt,
} = project.data;

const awards = project.data.awards ? await getEntries(project.data.awards) : [];
const { Content } = await render(project);
const dateRange = formatDateRange(startedAt, completedAt);
const galleryItems = getGalleryItems(project);
---

<Layout
	pageTitle={title}
	description={description}
	shareCard={`projects/${project.id}`}
>
	<main class="page-container">
		<article>
			<header>
				<h1>{title}</h1>
				<p>{description}</p>

				<div class="project-meta">
					<div class="meta-left">
						<span>{type}</span>
						{dateRange && <span>•</span>}
						{dateRange && <span>{dateRange}</span>}
					</div>
					<ProjectLinks project={project} />
				</div>

				<div class="project-role">
					<p class="role-title">{role}</p>
					{shortRoleDescription && <p>{shortRoleDescription}</p>}
				</div>
			</header>

			{galleryItems.length > 0 ? (
				<ProjectGallery items={galleryItems} title={title} />
			) : (
				<figure class="project-cover">
					<Image
						src={cover}
						alt={title}
						widths={[640, 960, 1280, 1920]}
						sizes="(max-width: 1160px) 100vw, 1128px"
						loading="eager"
					/>
				</figure>
			)}

			<TagList tags={tags} />

			{collaborators.length > 0 && (
				<p class="collaborators">
					<strong>Collaborators:</strong> {collaborators.join(", ")}
				</p>
			)}

			<div class="content-body">
				<Content />
			</div>

			{contribution && (
				<section class="project-section">
					<h2>Contribution</h2>
					<p class="contribution">{contribution}</p>
				</section>
			)}
		</article>

		{awards.length > 0 && (
			<section class="project-section" data-award-photos>
				<h2>Awards</h2>
				<ul class="award-list">
					{awards.map((award) => (
						<AwardCard award={award} />
					))}
				</ul>
				<Lightbox label={`${title} award photos`} />
			</section>
		)}
	</main>
</Layout>

<script>
	import "../../scripts/award-lightbox";
</script>

<style>
	/* Long lines are tiring to read, even though media uses the full width. */
	header > p,
	.project-role,
	.content-body,
	.contribution {
		max-width: 72ch;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.9rem, 3.2vw, 2.8rem);
		line-height: 1.1;
	}

	.project-meta {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
		align-items: center;
		justify-content: space-between;
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	.meta-left {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		text-transform: capitalize;
	}

	.project-role {
		margin-top: 1rem;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.project-role p {
		margin: 0;
	}

	.project-role .role-title {
		font-size: 1rem;
		font-weight: 500;
		color: var(--primary);
	}

	.project-cover {
		margin: 1.3rem 0 1rem;
	}

	.project-cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-sm);
	}

	.collaborators {
		margin: 1.3rem 0 0;
	}

	.content-body {
		margin-top: 1rem;
		line-height: 1.7;
		color: var(--text-secondary);
	}

	.project-section {
		margin-top: 2rem;
	}

	.project-section h2 {
		margin: 0 0 0.8rem;
		font-size: 1.35rem;
	}

	.contribution {
		line-height: 1.7;
	}

	.award-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 1rem 1.5rem;
		padding: 0;
		margin: 0;
	}

	@media (max-width: 720px) {
		.award-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
