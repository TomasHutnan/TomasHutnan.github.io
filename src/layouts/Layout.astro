---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";

import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import defaultShareImage from "../assets/og-default.png";

interface Props {
	description?: string;
	pageTitle?: string;
	shareImage?: ImageMetadata;
}

const {
	description = "Tomáš Hutňan portfolio: machine learning, computer vision, and full-stack software projects.",
	pageTitle,
	shareImage = defaultShareImage,
} = Astro.props;

const siteOwner = "Tomáš Hutňan";
const title = pageTitle ? `${pageTitle} • ${siteOwner}` : siteOwner;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Share scrapers handle JPEG most reliably, and 1200px wide is the size
// LinkedIn and X expect for a large preview card.
const socialImage = await getImage({
	src: shareImage,
	width: Math.min(shareImage.width, 1200),
	format: "jpeg",
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteOwner} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Navbar />
		<slot />
	</body>
</html>
