---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";

import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";

import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { CARD_HEIGHT, CARD_WIDTH, getShareCardPath } from "../utils/share-card";

interface Props {
	description?: string;
	pageTitle?: string;
	/**
	 * Which generated card link previews show, from src/pages/og: "default",
	 * "projects" or "projects/<id>".
	 */
	shareCard?: string;
}

const {
	description = "Tomáš Hutňan portfolio: machine learning, computer vision, and full-stack software projects.",
	pageTitle,
	shareCard = "default",
} = Astro.props;

const siteOwner = "Tomáš Hutňan";
const title = pageTitle ? `${pageTitle} • ${siteOwner}` : siteOwner;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const socialImageUrl = new URL(getShareCardPath(shareCard), Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteOwner} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content={String(CARD_WIDTH)} />
		<meta property="og:image:height" content={String(CARD_HEIGHT)} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
